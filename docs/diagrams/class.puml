@startuml
top to bottom direction
skinparam linetype ortho
skinparam class {
    BackgroundColor<<implemented>> #D5F5D5
    BorderColor<<implemented>> #2E7D32
    FontColor<<implemented>> #1B5E20

    BackgroundColor<<partial>> #FFF3CD
    BorderColor<<partial>> #B8860B
    FontColor<<partial>> #7A5600

    BackgroundColor<<planned>> #F8D7DA
    BorderColor<<planned>> #B02A37
    FontColor<<planned>> #842029

    BackgroundColor<<external>> #E3F2FD
    BorderColor<<external>> #1565C0
    FontColor<<external>> #0D47A1
}

legend right
|= Colour |
|<#D5F5D5> Implemented |
|<#FFF3CD> Partially implemented |
|<#F8D7DA> Planned / not implemented |
|<#E3F2FD> External dependency |
endlegend

' 0 = hide dependency lines
' 1 = show dependency lines
!$SHOW_DEPENDENCIES = 0



'=============================================================================='
'Utils Package'
'=============================================================================='
package "Utils" {
    class "Registry<T>" as BaseRegistry <<implemented>> {
        + register(key: str): Callable
        + get(key: str): T
        + known_keys(): set[str]
    }
}


'=============================================================================='
'Downloader Package'
'=============================================================================='
package "Download" {
    package "Model Domain Layer" #FFF8E1 {
        abstract class DownloadSpec <<implemented>> {
            + source: str
            + dest: Path
        }


        interface DownloadStrategy <<implemented>> {
            + validate(spec: DownloadSpec): None
            + fetch(spec: DownloadSpec): None
        }
        DownloadStrategy ..> DownloadSpec


        class Registry <<implemented>> {
            + register(source: str): Callable
            + get(source: str): DownloadStrategy
        }
        Registry ..> DownloadStrategy
    }


    package "Service Layer" #E8F5E9 {
        class Downloader <<implemented>> {
            - _registry: Registry

            + run(spec: DownloadSpec): None
        }
        Downloader --> Registry
        Downloader ..> DownloadSpec
    }

    package "Adapter Layer" #E3F2FD {
        class ArchiveStrategy <<implemented>> {
            - _auth: HTTPBasicAuth
        }
        ArchiveStrategy ..|> DownloadStrategy


        class ArchiveSpecs <<implemented>> {
            + url: str
            + username: str
            + password: str
            + dav_user: str
            + filename: str | None
            + extra: dict

            - _dav_root: str
            - _dav_url: str
            - _base_url: str
            - _header: dict
            - _body: str
            - _namespaces: dict
        }
        ArchiveSpecs --|> DownloadSpec
    }

}


'=============================================================================='
'Dataset Pruner Package'
'=============================================================================='
package "Dataset Pruner" {
    package "Service Layer" #E8F5E9 {
        class DatasetPruner <<partial>> {
            + source_name: list[str]
            + custom_steps: list[PruneStep]

            - _source: Source
            - _loader: Loader
            - _exporter: Exporter
            - _protocol_loader: ProtocolConfigLoader
            - _protocol_builder: ProtocolBuilder

            + init(): None
            + run(protocol_name: str | None): list[DataActor]
            + apply(actors, steps): list[DataActor]
        }
    }


    package "Model Domain Layer" #FFF8E1 {
        abstract class DataActor <<implemented>> {
            + name: ClassVar[str]

            + def copy_with(): DataActor
        }


        abstract class PruneStep <<implemented>> {
            + name: ClassVar[str]

            + def apply(actors: list[DataActor]): list[DataActor]
            + def from_config(data: dict): PruneStep
        }
        PruneStep ..> DataActor
        DatasetPruner --> PruneStep


        abstract class Protocol <<implemented>> {
            + steps: Sequence[PruneStep[Any, Any]]
        }
        Protocol o-- PruneStep


        class ProtocolRegistry <<implemented>> {
        }
        ProtocolRegistry --|> BaseRegistry
        ProtocolRegistry ..> Protocol


        package "Protocol Handlers"{
            class StepConfig <<planned>> {
                + kind: str
                + params: dict[str, Any]
            }


            class ProtocolConfig <<planned>> {
                + protocol_name: str
                + steps: list[StepConfig]
            }
            ProtocolConfig o-- StepConfig


            class ProtocolBuilder <<planned>> {
                + build(config: ProtocolConfig): Protocol
            }
            ProtocolBuilder ..> ProtocolConfig
            ProtocolBuilder ..> Protocol
            DatasetPruner --> ProtocolBuilder


            class ConfigProtocol <<planned>> {
                + name: str
            }
            Protocol <|-- ConfigProtocol
            ProtocolBuilder ..> ConfigProtocol
        }


        class StepRegistry <<planned>> {
            + register(name: str): Callable
            + get(name: str): type[PruneStep]
            + known_steps(): set[str]
        }
        StepRegistry ..> PruneStep
        ProtocolBuilder ..> StepRegistry


        abstract class MetadataActor <<implemented>> {
            + file_header: dict
            + file_name: str
            + file_path: Path
            + protocol_version: int = 0
            + directory_structure: str = "bids_local"

            + session_folder: Path
            + session_number: int
            + subject_folder: Path
            + subject_number: int
            + date_folder: Path
            + date: date
        }
        DataActor <|-- MetadataActor


        class XdfData <<implemented>> {
            + streams: list[dict]
        }
        MetadataActor <|-- XdfData


        class TrialData <<partial>> {
            + signal: NDArray
            + markers: NDArray
        }
        MetadataActor <|-- TrialData


        note as PruneStepsNote
            Currently implemented steps are:
            - RemoveSessionStep
            - SignalSplitStep
            - ProtocolDefinerStep
            - AnalogFilterStep
            - SignalUnwarpStep
            - MarkerUnificationStep
            - BuildEpochs
            - TTVSplitStep
        end note
        PruneStep <|-- PruneStepsNote
    }


    package "Adapter Layer" #E3F2FD {
        class Source <<implemented>> {
            + data_dir: Path
            + dataset_dir: Path

            + def final_data_dir(dataset_name: str): Path
            + def out_dir(dataset_name: str): Path
        }
        Source <-- DatasetPruner


        class Loader <<implemented>> {
            + source: Source

            + load(source_names: list[str]): list[DataActor]
        }
        Loader ..> DataActor
        DatasetPruner --> Loader


        class ProtocolConfigLoader <<planned>> {
            + config_dir: Path

            + load(protocol_name: str): ProtocolConfig
        }
        ProtocolConfigLoader ..> ProtocolConfig
        DatasetPruner --> ProtocolConfigLoader


        package "Loader Sub-Classes"{
            abstract class FileLoader <<implemented>> {
                + def load_file(path: Path): list[DataActor]
            }
            FileLoader ..> DataActor


            class FileLoaderRegistry <<implemented>> {

            }
            FileLoaderRegistry --|> BaseRegistry
            FileLoaderRegistry ..> FileLoader
            Loader --> FileLoaderRegistry


            class XdfLoader <<implemented>> {

            }
            FileLoader <|.. XdfLoader
        }


        class Exporter <<implemented>> {
            + source: Source

            + export(actors: list[DataActor], protocol_name: str, fmt: str, zip_groups: bool): None
        }
        Exporter ..> DataActor
        Exporter --> Source
        DatasetPruner --> Exporter


        package "Exporter Sub-Classes"{
            class ExportContext <<implemented>> {
                + protocol_name: str
                + timestamp: str
                + fmt: str
                + zip_groups: bool
            }
            Exporter ..> ExportContext


            abstract class "Writer<A: DataActor>" as Writer <<implemented>> {
                + def write(actor: A, dest_dir: Path, ctx: ExportContext): None
            }
            Writer ..> DataActor
            Writer ..> ExportContext


            class WriterRegistry <<implemented>> {
                + register_for(actor: str, fmt: str): Callable
                + get_for(actor: str, fmt: str): Writer
            }
            WriterRegistry --|> BaseRegistry
            WriterRegistry ..> Writer
            WriterRegistry <-- Exporter


            class DatasetWriter <<implemented>> {
            }
            Writer <|.. DatasetWriter
            DatasetWriter ..> WriterRegistry


            class FifWriter <<implemented>> {
                + suffix: ClassVar[str]
            }
            Writer <|.. FifWriter
        }

    }
}
@enduml
