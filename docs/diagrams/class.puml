@startuml
top to bottom direction
skinparam linetype ortho
skinparam class {
    BackgroundColor<<implemented>> #D5F5D5
    BorderColor<<implemented>> #2E7D32
    FontColor<<implemented>> #1B5E20

    BackgroundColor<<partial>> #FFF3CD
    BorderColor<<partial>> #B8860B
    FontColor<<partial>> #7A5600

    BackgroundColor<<planned>> #F8D7DA
    BorderColor<<planned>> #B02A37
    FontColor<<planned>> #842029

    BackgroundColor<<external>> #E3F2FD
    BorderColor<<external>> #1565C0
    FontColor<<external>> #0D47A1
}

legend right
|= Colour |
|<#D5F5D5> Implemented |
|<#FFF3CD> Partially implemented |
|<#F8D7DA> Planned / not implemented |
|<#E3F2FD> External dependency |
endlegend

' 0 = hide dependency lines
' 1 = show dependency lines
!$SHOW_DEPENDENCIES = 0



'=============================================================================='
'Utils Package'
'=============================================================================='
package "Utils" {
    class Registry <<implemented>> {
        + register(key: str): Callable
        + get(key: str): T
        + get_type(key: str): type[T]
        + known_keys(): set[str]
    }
}


'=============================================================================='
'Downloader Package'
'=============================================================================='
package "Download" {
    package "Model Domain Layer" #FFF8E1 {
        abstract class DownloadSpec <<implemented>> {
            + source: str
            + dest: Path
        }


        interface DownloadStrategy <<implemented>> {
            + validate(spec: DownloadSpec): None
            + fetch(spec: DownloadSpec): None
        }
        DownloadStrategy ..> DownloadSpec


        class Registry <<implemented>> {
            + register(source: str): Callable
            + get(source: str): DownloadStrategy
        }
        Registry ..> DownloadStrategy
    }


    package "Service Layer" #E8F5E9 {
        class Downloader <<implemented>> {
            - _registry: Registry

            + run(spec: DownloadSpec): None
        }
        Downloader --> "Download.Model Domain Layer.Registry"
        Downloader ..> DownloadSpec
    }

    package "Adapter Layer" #E3F2FD {
        class ArchiveStrategy <<implemented>> {
            - _auth: HTTPBasicAuth
        }
        ArchiveStrategy ..|> DownloadStrategy


        class ArchiveSpecs <<implemented>> {
            + url: str
            + username: str
            + password: str
            + dav_user: str
            + filename: str | None
            + extra: dict

            - _dav_root: str
            - _dav_url: str
            - _base_url: str
            - _header: dict
            - _body: str
            - _namespaces: dict
        }
        ArchiveSpecs --|> DownloadSpec
    }

}


'=============================================================================='
'Dataset Pruner Package'
'=============================================================================='
package "Dataset Pruner" {
    package "Service Layer" #E8F5E9 {
        class DatasetPruner <<implemented>> {
            + source_name: list[str]
            + custom_steps: list[PruneStep]

            - _data_dir: Path = "data/"
            - _config_dir: Path = "configs/prune/"
            - _source: Source
            - _loader: Loader
            - _exporter: Exporter
            - _protocol_loader: ProtocolLoader

            + run(protocol_name: str | None): list[DataActor]
            + export(actors: list[DataActor], protocol_name: str): None
            + apply(actors: list[DataActor], steps: Sequence[PruneStep]): list[DataActor]
        }
    }


    package "Model Domain Layer" #FFF8E1 {
        package "Actors" {
            abstract class DataActor <<implemented>> {
                + name: ClassVar[str]

                + def copy_with(**changes): Self
            }


            abstract class MetadataActor <<implemented>> {
                + file_header: dict
                + file_name: str
                + file_path: Path
                + directory_structure: str = "bids_local"
                + protocol_version: int = 0
                + signal_type: Signal | None = None

                + session_folder: Path | None
                + session_number: int | None
                + subject_folder: Path | None
                + subject_number: int | None
                + date_folder: Path | None
                + date: date | None
            }
            DataActor <|-- MetadataActor


            class XdfData <<implemented>> {
                + streams: list[dict]
            }
            MetadataActor <|-- XdfData


            class TrialData <<implemented>> {
                + signal_ch: NDArray
                + markers: NDArray
                + channel_names: list[str]
                + sfreq: float
            }
            MetadataActor <|-- TrialData


            class DatasetPartition <<implemented>> {
                + name = "dataset_partition"
                + partition_name: "train" | "val" | "test"
                + trials: list[TrialData]

                + mne_dataset: BaseRaw
            }
            DataActor <|-- DatasetPartition
            DatasetPartition o-- TrialData


            class Dataset <<implemented>> {
                + name = "dataset"
                + client: list[DatasetPartition]
                + server: list[DatasetPartition]
            }
            DataActor <|-- Dataset
            Dataset o-- DatasetPartition
        }


        abstract class PruneStep <<implemented>> {
            + name: ClassVar[str]

            + def from_config(data: dict): PruneStep
            + def apply(actors: list[DataActor]): list[DataActor]
        }
        PruneStep ..> DataActor
        DatasetPruner --> PruneStep


        class StepRegistry <<implemented>> {
        }
        StepRegistry --|> Utils.Registry
        StepRegistry ..> PruneStep


        note as PruneStepsNote
            Currently implemented steps (YAML key):
            - RemoveSessionStep (remove_session)
            - SignalSplitStep (signal_split)
            - ProtocolDefinerStep (protocol_definer)
            - SignalUnwarpStep (signal_unwarp)
            - AnalogueFilterStep (analogue_filter)
            - MarkerUnificationStep (marker_unification)
            - BuildEpochs (build_epochs)
            - TTVSplitStep (ttv_split)
        end note
        PruneStep <|-left- PruneStepsNote


        class Protocol <<implemented>> {
            + name: str
            + steps: Sequence[PruneStep[Any, Any]]
        }
        Protocol o-- PruneStep
    }


    package "Adapter Layer" #E3F2FD {
        class Source <<implemented>> {
            + data_dir: Path
            + dataset_dir: Path

            + def raw_data_dir(dataset_path: Path): Path
            + def out_dir(protocol_name: str): Path
        }
        Source <-- DatasetPruner


        class Loader <<implemented>> {
            + source: Source

            + load(source_names: list[str]): list[DataActor]
        }
        Loader ..> DataActor
        Loader --> Source
        DatasetPruner --> Loader


        class ProtocolLoader <<implemented>> {
            + config_dir: Path

            + load(protocol_name: str): Protocol
            + load_writers(protocol_name: str, timestamp: str): list[Writer]
        }
        ProtocolLoader ..> Protocol
        ProtocolLoader ..> StepRegistry
        DatasetPruner --> ProtocolLoader


        package "Loader Sub-Classes" {
            abstract class FileLoader <<implemented>> {
                + def load_file(path: Path): DataActor
            }
            FileLoader ..> DataActor


            class FileLoaderRegistry <<implemented>> {
            }
            FileLoaderRegistry --|> Utils.Registry
            FileLoaderRegistry ..> FileLoader
            Loader --> FileLoaderRegistry


            note as FileLoadersNote
                Currently implemented file loaders (suffix):
                - XdfLoader (.xdf)
            end note
            FileLoader <|-- FileLoadersNote
        }


        class Exporter <<implemented>> {
            + export(actors: list[DataActor], writers: list[Writer], dest_dir: Path): None
        }
        Exporter ..> DataActor
        DatasetPruner --> Exporter


        package "Exporter Sub-Classes" {
            abstract class Writer <<implemented>> {
                + name: ClassVar[str]
                + actor: ClassVar[str]
                + timestamp: str

                + def from_config(data: dict, timestamp: str): Writer
                + def write(actor: DataActor, dest_dir: Path): None
            }
            Writer ..> DataActor
            Exporter ..> Writer


            class WriterRegistry <<implemented>> {
            }
            WriterRegistry --|> Utils.Registry
            WriterRegistry ..> Writer
            ProtocolLoader ..> WriterRegistry


            note as WritersNote
                Currently implemented writers (YAML key):
                - DatasetWriter (dataset): fmt, zip_groups
            end note
            Writer <|-- WritersNote
        }
    }
}


'=============================================================================='
'Models Package'
'=============================================================================='
package "Models" {
    package "Service Layer" #E8F5E9 {
        class ModelTrainer <<planned>> {
            + data_dir: Path = "data/dataset/"
            + config_dir: Path = "configs/model/train/"

            - _reader: DatasetReader
            - _config_loader: ConfigLoader
            - _store: ArtifactStore

            + run(protocol_name: str): ModelArtifact
        }


        class ModelEvaluator <<planned>> {
            + data_dir: Path = "data/dataset/"
            + config_dir: Path = "configs/model/eval/"

            - _reader: DatasetReader
            - _config_loader: ConfigLoader
            - _store: ArtifactStore

            + run(protocol_name: str): EvaluationReport
        }
    }


    package "Model Domain Layer" #FFF8E1 {
        package "Model Actors" {
            class PartitionData <<planned>> {
                + name = "partition_data"
                + group: "client" | "server"
                + partition_name: "train" | "val" | "test"
                + signals: list[NDArray]
                + markers: list[NDArray]
                + subjects: list[int]
                + channel_names: list[str]
                + sfreq: float
            }


            class WindowSet <<planned>> {
                + name = "window_set"
                + source: PartitionData
                + x: NDArray
                + y: NDArray | None
                + subjects: NDArray
                + class_labels: list[str]
            }
            WindowSet o-- PartitionData


            class Predictions <<planned>> {
                + name = "predictions"
                + partition: str
                + y_pred: NDArray
                + y_proba: NDArray | None
                + y_true: NDArray | None
                + subjects: NDArray
            }


            note as ModelActorsNote
                All three subclass the prune DataActor
                (dataclass, name ClassVar, copy_with).
            end note
            PartitionData <|-- ModelActorsNote
        }


        class WindowConfig <<planned>> {
            + size_ms: float = 200
            + step_ms: float = 100
            + max_per_trial: int | None = 10
            + only_labelled: bool = True
            + label_rule: "majority" | "last" = "majority"
            + classes: list[str] | None
            + one_vs_all: str | None

            + def apply(partition: PartitionData): WindowSet
        }
        WindowConfig ..> PartitionData
        WindowConfig ..> WindowSet


        abstract class Model <<planned>> {
            + name: ClassVar[str]
            + seed: int

            + def from_config(data: dict, seed: int): Model
            + def fit(train: WindowSet, val: WindowSet | None): TrainingReport
            + def predict(windows: WindowSet): Predictions
            + def to_bytes(): bytes
            + def from_bytes(data: bytes): Model
        }
        Model ..> WindowSet
        Model ..> Predictions


        package "Model Implementations" {
            abstract class SklearnModel <<planned>> {
                + params: dict
                + features: list[str]
            }
            SklearnModel --|> Model


            abstract class TorchModel <<planned>> {
                + epochs: int
                + batch_size: int
                + learning_rate: float
                + device: str = "auto"
            }
            TorchModel --|> Model


            note as ModelsNote
                Planned models (YAML key):
                - SvmModel (svm): SklearnModel
                - LogisticRegressionModel (logistic_regression): SklearnModel
                - DecisionTreeModel (decision_tree): SklearnModel
                - TcnnModel (tcnn): TorchModel, Atzori 2016
            end note
            SklearnModel <|-- ModelsNote
        }


        class ModelRegistry <<planned>> {
        }
        ModelRegistry --|> Utils.Registry
        ModelRegistry ..> Model


        abstract class Metric <<planned>> {
            + name: ClassVar[str]

            + def score(predictions: Predictions): float | NDArray
        }
        Metric ..> Predictions


        class MetricRegistry <<planned>> {
        }
        MetricRegistry --|> Utils.Registry
        MetricRegistry ..> Metric


        note as MetricsNote
            Planned metrics (YAML key):
            - Accuracy (accuracy)
            - BalancedAccuracy (balanced_accuracy)
            - CohenKappa (cohen_kappa)
            - F1 (f1): average
            - ConfusionMatrix (confusion_matrix)
            - FlipsPerSecond (flips_per_second)
        end note
        Metric <|-- MetricsNote


        abstract class EvaluationScheme <<planned>> {
            + name: ClassVar[str]

            + def split(predictions: Predictions): dict[str, Predictions]
        }
        EvaluationScheme ..> Predictions


        class SchemeRegistry <<planned>> {
        }
        SchemeRegistry --|> Utils.Registry
        SchemeRegistry ..> EvaluationScheme


        note as SchemesNote
            Planned schemes (YAML key):
            - PooledScheme (pooled)
            - PerSubjectScheme (per_subject)
            - PerClassScheme (per_class)
        end note
        EvaluationScheme <|-- SchemesNote


        class DatasetRef <<planned>> {
            + protocol: str
            + timestamp: str = "latest"
        }


        class TrainProtocol <<planned>> {
            + name: str
            + seed: int
            + dataset: DatasetRef
            + window: WindowConfig
            + model: Model
            + val_metrics: Sequence[Metric]
            + reports: Sequence[ReportWriter]
        }
        TrainProtocol --> WindowConfig
        TrainProtocol o-- Model
        TrainProtocol o-- Metric
        TrainProtocol --> DatasetRef


        class EvalProtocol <<planned>> {
            + name: str
            + artifact: Path
            + dataset: DatasetRef
            + targets: list[str]
            + metrics: Sequence[Metric]
            + schemes: Sequence[EvaluationScheme]
            + reports: Sequence[ReportWriter]
        }
        EvalProtocol o-- Metric
        EvalProtocol o-- EvaluationScheme
        EvalProtocol --> DatasetRef


        class ModelArtifact <<planned>> {
            + name: str
            + model_key: str
            + model_params: dict
            + window: WindowConfig
            + class_labels: list[str]
            + channel_names: list[str]
            + sfreq: float
            + seed: int
            + dataset: DatasetRef
            + git_commit: str
            + created_at: str
            + path: Path
        }
        ModelArtifact --> DatasetRef
        ModelArtifact --> WindowConfig


        class TrainingReport <<planned>> {
            + history: dict[str, list[float]]
            + val_scores: dict[str, float]
            + fit_seconds: float
            + n_parameters: int
            + size_bytes: int
        }


        class EvaluationReport <<planned>> {
            + artifact: ModelArtifact
            + scores: dict[str, dict[str, float]]
            + predictions: list[Predictions]
        }
        EvaluationReport --> ModelArtifact
    }


    package "Adapter Layer" #E3F2FD {
        class DatasetReader <<planned>> {
            + data_dir: Path

            + read(ref: DatasetRef, partitions: list[str]): list[PartitionData]
        }
        DatasetReader ..> PartitionData
        ModelTrainer --> DatasetReader
        ModelEvaluator --> DatasetReader


        class ConfigLoader <<planned>> {
            + config_dir: Path

            + load_train(name: str): TrainProtocol
            + load_eval(name: str): EvalProtocol
        }
        ConfigLoader ..> TrainProtocol
        ConfigLoader ..> EvalProtocol
        ModelTrainer --> ConfigLoader
        ModelEvaluator --> ConfigLoader


        class ArtifactStore <<planned>> {
            + root: Path = "artifacts/models/"

            + save(model: Model, artifact: ModelArtifact, report: TrainingReport): Path
            + load(path: Path): Model
        }
        ArtifactStore ..> ModelArtifact
        ArtifactStore ..> ModelRegistry
        ModelTrainer --> ArtifactStore
        ModelEvaluator --> ArtifactStore
        ArtifactStore ..> Model


        package "Report Writers" {
            abstract class ReportWriter <<planned>> {
                + name: ClassVar[str]

                + def from_config(data: dict): ReportWriter
                + def write(report: TrainingReport | EvaluationReport, dest_dir: Path): None
            }


            class ReportWriterRegistry <<planned>> {
            }
            ReportWriterRegistry --|> Utils.Registry
            ReportWriterRegistry ..> ReportWriter


            note as ReportWritersNote
                Planned report writers (YAML key):
                - JsonMetricsWriter (json_metrics)
                - PredictionsCsvWriter (predictions_csv)
                - ConfusionPlotWriter (confusion_plot)
                - TrainingCurvesWriter (training_curves)
            end note
            ReportWriter <|-- ReportWritersNote
        }
    }
}

!if ($SHOW_DEPENDENCIES == 1)
PartitionData --|> DataActor
WindowSet --|> DataActor
Predictions --|> DataActor
DatasetReader ..> DatasetWriter
ConfigLoader ..> ModelRegistry
ConfigLoader ..> MetricRegistry
ConfigLoader ..> SchemeRegistry
ConfigLoader ..> ReportWriterRegistry
ModelTrainer ..> WindowConfig
ModelEvaluator ..> WindowConfig
ModelTrainer ..> ReportWriter
ModelEvaluator ..> Metric
ModelEvaluator ..> EvaluationScheme
ModelEvaluator ..> ReportWriter
!endif
@enduml
