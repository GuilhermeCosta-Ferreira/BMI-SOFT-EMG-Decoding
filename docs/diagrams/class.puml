@startuml
top to bottom direction
skinparam linetype ortho
skinparam class {
    BackgroundColor<<implemented>> #D5F5D5
    BorderColor<<implemented>> #2E7D32
    FontColor<<implemented>> #1B5E20

    BackgroundColor<<partial>> #FFF3CD
    BorderColor<<partial>> #B8860B
    FontColor<<partial>> #7A5600

    BackgroundColor<<planned>> #F8D7DA
    BorderColor<<planned>> #B02A37
    FontColor<<planned>> #842029

    BackgroundColor<<external>> #E3F2FD
    BorderColor<<external>> #1565C0
    FontColor<<external>> #0D47A1
}

legend right
|= Colour |
|<#D5F5D5> Implemented |
|<#FFF3CD> Partially implemented |
|<#F8D7DA> Planned / not implemented |
|<#E3F2FD> External dependency |
endlegend

' 0 = hide dependency lines
' 1 = show dependency lines
!$SHOW_DEPENDENCIES = 0



'=============================================================================='
'Downloader Package'
'=============================================================================='
package "Download" {
    package "Model Domain Layer" #FFF8E1 {
        abstract class DownloadSpec <<implemented>> {
            + source: str
            + dest: Path
        }


        interface DownloadStrategy <<implemented>> {
            + validate(spec: DownloadSpec): None
            + fetch(spec: DownloadSpec): None
        }
        DownloadStrategy ..> DownloadSpec


        class Registry <<implemented>> {
            + register(source: str, strategy: DownloadStrategy): None
            + get(source: str): DownloadStrategy
        }
        Registry ..> DownloadStrategy
    }


    package "Service Layer" #E8F5E9 {
        class Downloader <<implemented>> {
            - _registry: Registry

            + run(spec: DownloadSpec): None
        }
        Downloader --> Registry
        Downloader ..> DownloadSpec
    }

    package "Adapter Layer" #E3F2FD {
        class ArchiveStrategy <<implemented>> {
            - _auth: HTTPBasicAuth
        }
        ArchiveStrategy ..|> DownloadStrategy


        class ArchiveSpecs <<implemented>> {
            + url: str
            + username: str
            + password: str
            + dav_user: str
            + filename: str | None
            + extra: dict

            - _dav_root: str
            - _dav_url: str
            - _base_url: str
            - _header: dict
            - _body: str
            - _namespaces: dict
        }
        ArchiveSpecs --|> DownloadSpec
    }

}


'=============================================================================='
'Dataset Pruner Package'
'=============================================================================='
package "Dataset Pruner" {
    package "Service Layer" #E8F5E9 {
        class DatasetPruner <<partial>> {
            + source_name: list[str]

            - _source: Source
            - _loader: Loader

            + init(): None
            + run(): None
            + add_step(list[PruneStep]): None
        }
    }


    package "Model Domain Layer" #FFF8E1 {
        abstract class DataActor <<implemented>> {
            + name: ClassVar[str]

            + def copy_with(): DataActor
        }


        abstract class PruneSpecs <<implemented>> {
            name: ClassVar[str]

        }


        abstract class PruneStep <<implemented>> {
            + name: ClassVar[str]
            + config: PruneSpecs

            + def apply(actors: list[DataActor]): list[DataActor]
        }
        PruneStep ..> DataActor
        PruneStep o-- PruneSpecs
        DatasetPruner --> PruneStep


        abstract class Protocol <<implemented>> {
            + steps: Sequence[PruneStep[Any, Any]]
            + specs: Sequence[PruneSpecs]
        }
        Protocol o-- PruneSpecs
        Protocol o-- PruneStep


        class ProtocolRegistry <<implemented>> {
            + register(name: str, protocol: Protocol): None
            + get(name: str): Protocol
        }
        ProtocolRegistry ..> Protocol


        abstract class XdfActor <<implemented>> {
            + file_header: dict
            + file_name: str
            + file_path: Path
            + protocol_version: int = 0
            + directory_structure: str = "bids_local"

            + session_folder: Path
            + session_number: int
            + subject_folder: Path
            + subject_number: int
            + date_folder: Path
            + date: date
        }
        DataActor <|-- XdfActor


        class XdfData <<implemented>> {
            + streams: list[dict]
        }
        XdfActor <|-- XdfData


        class TrialData <<implemented>> {
            + signal: NDArray
            + markers: NDArray
        }
        XdfActor <|-- TrialData


        class RemoveSessionStep <<implemented>> {
        }
        PruneStep <|-- RemoveSessionStep


        class SignalSplitStep <<implemented>> {
        }
        PruneStep <|-- SignalSplitStep


        class ProtocolDefinerStep <<implemented>> {
        }
        PruneStep <|-- ProtocolDefinerStep


        class RemoveSessionSpecs <<implemented>> {
            + name: ClassVar[str] = "remove_sessions"
            + files_to_remove: list[str]
        }
        PruneSpecs <|-- RemoveSessionSpecs


        class SignalSplitSpecs <<implemented>> {
            + name: ClassVar[str] = "signal_split"
            + signal: Signal
        }
        PruneSpecs <|-- SignalSplitSpecs


        class ProtocolDefinerSpecs <<implemented>> {
            + name: ClassVar[str] = "protocol_definer"
            + cuttoff_dates: list[date]
        }
        PruneSpecs <|-- ProtocolDefinerSpecs
    }


    package "Adapter Layer" #E3F2FD {
        class Source <<implemented>> {
            + data_dir: Path
            + dataset_dir: Path

            + def final_data_dir(dataset_name: str): Path
            + def out_dir(dataset_name: str): Path
        }
        Source <-- DatasetPruner


        class Loader <<implemented>> {
            + source: Source

            + load(source_names: list[str]): list[DataActor]
        }
        Loader ..> DataActor
        DatasetPruner --> Loader


        abstract class FileLoader <<implemented>> {
            + def load_file(path: Path): list[DataActor]
        }
        FileLoader ..> DataActor


        class FileLoaderRegistry <<implemented>> {
            + register(suffix: str): Callable
            + get(suffix: str): FileLoader
            + known_suffixes(): set[str]
        }
        FileLoaderRegistry ..> FileLoader
        Loader --> FileLoaderRegistry


        class XdfLoader <<implemented>> {

        }
        FileLoader <|.. XdfLoader
    }
}



@enduml
